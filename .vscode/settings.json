{
    "python.languageServer": "Jedi",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/ports/*/lib", // globs seem not implemented yet
        "${workspaceFolder}/lib.stubs",
        "${workspaceFolder}/lib.local",
        "${workspaceFolder}/stubs/adafruit-circuitpython-bundle-py/lib",
        "${workspaceFolder}/stubs/circuitpython-community-bundle-py/lib",
    ],
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none",
        "reportShadowedImports": "none"
    },
    "python.analysis.extraPaths": [
        "${workspaceFolder}/ports/*/lib", // why this doesn't work?
        "${workspaceFolder}/lib.stubs",
        "${workspaceFolder}/lib.local",
        "${workspaceFolder}/stubs/adafruit-circuitpython-bundle-py/lib",
        "${workspaceFolder}/stubs/circuitpython-community-bundle-py/lib",
    ],
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.wordBasedSuggestions": "currentDocument",
        "editor.indentSize": "tabSize",
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.insertSpaces": false,
    },
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.rulers": [80],
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80,
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        }
    },
}